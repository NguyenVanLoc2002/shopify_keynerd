    "testimonials-1": {
      "type": "testimonials",
      "blocks": {
        "testimonial-1": {
          "type": "testimonial",
          "settings": {
            "review": "These leggings feel like a second skin! The fit is perfect, and they move with me no matter the workout. I've tried so many brands, and this is by far the best activewear I've ever worn.",
            "reviewer": "Emma L.",
            "reviewer_description": "Fitness Enthusiast",
            "rating": 5
          }
        },
        "testimonial-4": {
          "type": "testimonial",
          "settings": {
            "review": "Unbelievably flexible! These leggings stretch without losing shape—perfect for yoga and HIIT.",
            "reviewer": "Lena K.",
            "reviewer_description": "Yoga Instructor",
            "rating": 5
          }
        },
        "testimonial-2": {
          "type": "testimonial",
          "settings": {
            "review": "As a personal trainer, I need gear that lasts. This activewear holds up through intense workouts, stays breathable, and still looks brand new after months of use. Highly recommend!",
            "reviewer": "James R.",
            "reviewer_description": "Certified Trainer",
            "rating": 5
          }
        },
        "testimonial-5": {
          "type": "testimonial",
          "settings": {
            "review": "Finally, activewear that looks as good as it performs. Stylish, breathable, and super comfy!",
            "reviewer": "David S.",
            "reviewer_description": "Athlete",
            "rating": 5
          }
        },
        "testimonial-3": {
          "type": "testimonial",
          "settings": {
            "review": "I used to struggle with activewear that felt heavy and soaked up sweat. This brand changed everything! The moisture-wicking fabric keeps me cool and dry, even during my toughest runs.",
            "reviewer": "Sophia M.",
            "reviewer_description": "Marathon Runner",
            "rating": 5
          }
        }
      },
