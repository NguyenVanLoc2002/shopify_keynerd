
{% style %}
#shopify-section-{{ section.id }} {
  
  {% unless section.settings.fullwidth %}
    --theme-section-custom-width: {{ section.settings.width | append: 'px' }};
  {% endunless %}

  {% if section.settings.inset %}
    --theme-section-content-padding: var(--theme-section-content-padding-{{ section.settings.inset_choice }});
  {% endif %}

  {% if section.settings.side_margin_choice != 'level-0' %}
    --theme-section-side-margin: var(--theme-section-side-margin-{{ section.settings.side_margin_choice }});
  {% endif %}

}
{% endstyle %}



{% style %}
  #shopify-section-{{ section.id }} {
    {% if section.settings.height_mobile != 'auto' %}
      --theme-image-before-after-custom-height-mobile: {{ section.settings.height_mobile | append: 'px' }};
    {% endif %}

    {% if section.settings.height != 'auto' %}
      --theme-image-before-after-custom-height-desktop: {{ section.settings.height | append: 'px' }};
    {% endif %}
  }
{% endstyle %}


{% if section.settings.separator %}
  {% style %}
  #shopify-section-{{ section.id }} .separator{
    --theme-section-separator-width: {{ section.settings.separator_width | append: '%' }};

    {% if section.settings.separator_use_custom_color %}
      --theme-section-separator-color: {{ section.settings.separator_custom_color }};
    {% endif %}
  }
  {% endstyle %}
{% endif %}

{% if section.settings.spacing %}
  {% style %}
  #shopify-section-{{ section.id }}{
    
      {% unless section.settings.spacing_placement == '3' %}
--theme-section-spacing-top: var(--theme-spacing-{{ section.settings.spacing_choice }});
{% endunless %}
{% unless section.settings.spacing_placement == '2' %}
      --theme-section-spacing-bottom: var(--theme-spacing-{{ section.settings.spacing_choice }});
{% endunless %}

  }
  {% endstyle %}
{% endif %}


<div class="section-image-before-after{% liquid 

  if section.settings.fullwidth
    echo ' has-fullwidth'
  else
    echo ' has-custom-width'
  endif

  if section.settings.side_margin_choice != 'level-0'
    echo ' has-side-margin'
  endif

  if section.settings.inset
    echo ' has-section-padding'
  endif

  echo ' ' | append: section.settings.color_scheme

  if settings.animation_sections
    echo ' has-animation'
  endif
  
%}">
<div class="section-image-before-after-container section-container">
    {% if section.settings.text_1 != blank or section.settings.text_2 != blank or section.settings.button_text != blank %}
        <div class="section-image-before-after-header">
        {% if section.settings.text_1 != blank or section.settings.text_2 != blank %}
            <div class="section-image-before-after-header__left">
            {% if section.settings.text_1 != blank %}
                <h2 class="section-image-before-after-header__heading heading-size-{{ section.settings.text_1_size }}">{{ section.settings.text_1 }}</h2>
            {% endif %}

            {% if section.settings.text_2 != blank %}
                <p class="section-image-before-after-header__description paragraph-size-{{ section.settings.text_2_size }}">{{ section.settings.text_2 }}</p>
            {% endif %}
            </div>
        {% endif %}
        {% if section.settings.button_text != blank %}
            {% render 'button', 
                button_text: section.settings.button_text,  
                button_url: section.settings.button_url,
                button_style: section.settings.button_style,
                button_classes: 'section-image-before-after-button',
                button_target: section.settings.button_target
            %}
        {% endif %}
        </div>
    {% endif %}
    {% if section.blocks != blank %}
    <before-after class="before-after section-image-before-after-content">
        <div class="before-after-content">
            {% for block in section.blocks %}
                {% if block.type == 'image' %}
                    <div class="before-after-image{% liquid
  
                        echo ' ' | append: block.settings.color_scheme

                        %} block-{{ block.id }}" {{ block.shopify_attributes }}>
                        <div class="before-after-image__image">
                            {% liquid
                                if block.settings.image != blank or block.settings.image_mobile != blank
                                    render 'section-image-processor', image: block.settings.image, image_mobile: block.settings.image_mobile
                                else 
                                    assign placeholder_image = 'lifestyle-' | append: forloop.index
                                    echo placeholder_image | placeholder_svg_tag: 'placeholder placeholder-image-before-after'
                                endif
                            %}
                        </div>
                        <h3 class="before-after-image__heading heading-size-{{ block.settings.text_size }}">{{ block.settings.text }}</h3>
                    </div>
                {% endif %}
            {% endfor %}
        </div>
        <div class="before-after-handler">
            <span class="before-after-handler-button"></span>
        </div>
    </before-after>
    {% endif %}
</div>
</div>
{% if section.settings.separator %}
  <div class="section-separator{% liquid 
echo ' ' | append: section.settings.color_scheme
 %}"><hr class="separator"></div>
{% endif %}


